{
  "name": "dto-solution",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:company": "vite --config vite.company.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "build": "vite build && vite build --config vite.admin.config.js",
    "build:company": "vite build --config vite.company.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "test:driver": "node scripts/test-driver.mjs",
    "driver:styles": "tailwindcss -c scripts/driver-tailwind.config.cjs -i src/features/driver/driver-tools.input.css -o src/features/driver/driver-tools.generated.css --minify",
    "verify:driver": "node scripts/verify-driver-provenance.mjs",
    "test:driver:browser": "node scripts/verify-driver-pdf.mjs && node scripts/verify-driver-browser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@radix-ui/react-alert-dialog": "1.1.14",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.12",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "driver-payroll-pdfjs": "npm:pdfjs-dist@6.1.200",
    "jspdf": "4.2.1",
    "lucide-react": "0.462.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "6.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "20.0.3",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.8.3",
    "vite": "^8.2.0",
    "vitest": "3.2.4"
  }
}
