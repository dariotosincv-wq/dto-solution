VITE_SUPABASE_ANON_KEY=
VITE_CHECKVAN_SUPABASE_URL=
VITE_CHECKVAN_SUPABASE_ANON_KEY=

# DTO Solution Auth - Area Aziende browser (publishable/anon only)
VITE_COMPANY_SUPABASE_URL=
VITE_COMPANY_SUPABASE_ANON_KEY=

# DTO Solution Auth - Vercel/server-side JWT verification
DTO_SUPABASE_URL=
DTO_SUPABASE_ANON_KEY=

# CheckVan licensing - Vercel/server-side only. Never prefix with VITE_.
CHECKVAN_SUPABASE_URL=
CHECKVAN_SUPABASE_SERVICE_ROLE_KEY=
CHECKVAN_STORAGE_TUS_URL=

# Google Drive company archive - Vercel/server-side only. Never prefix with VITE_.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# Exactly 32 random bytes encoded as base64, e.g. generated with: openssl rand -base64 32
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_REDIRECT_URI=https://www.dtosolution.it/api/company-cloud

# Comma-separated DTO Auth user UUIDs allowed to provision organizations and licenses.
DTO_ADMIN_SUBJECTS=
